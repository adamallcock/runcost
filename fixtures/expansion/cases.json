    {
      "id": "openai-chat-batch-partial",
      "operation": "from_batch_results",
      "input": {
        "provider": "openai",
        "endpoint": "/v1/chat/completions",
        "model": "fixture-chat",
        "batch_id": "batch_fixture",
        "price_cards_ref": "openai-chat-batch",
        "items": [
          {
            "custom_id": "request-ok",
            "response": {
              "status_code": 200,
              "body": {
                "object": "chat.completion",
                "model": "fixture-chat",
                "choices": [],
                "usage": { "prompt_tokens": 100, "prompt_tokens_details": { "cached_tokens": 20 }, "completion_tokens": 50, "completion_tokens_details": { "reasoning_tokens": 10 } }
              }
            },
            "error": null
          },
          { "custom_id": "request-failed", "response": { "status_code": 429, "body": { "message": "rate limited" } }, "error": { "message": "rate limited" } }
        ]
      },
      "expected": {
        "batch_id": "batch_fixture",
        "summary": { "total": 2, "succeeded": 1, "failed": 1, "pending": 0, "total_cost": "0.000182" },
        "items": [
          { "id": "request-ok", "status": "succeeded", "metadata": { "service_tier": "batch", "batch_item_id": "request-ok", "batch_id": "batch_fixture" }, "ledger": { "total": "0.000182" } },
          { "id": "request-failed", "status": "errored", "http_status": 429, "error": { "message": "rate limited" } }
