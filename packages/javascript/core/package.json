{
  "name": "runcost",
  "version": "0.2.2",
  "type": "module",
  "description": "Local, auditable and itemized USD cost ledger for LLM provider responses, with price sources and warnings.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/adamallcock/runcost#readme",
  "bugs": {
    "url": "https://github.com/adamallcock/runcost/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamallcock/runcost.git",
    "directory": "packages/javascript/core"
  },
  "keywords": [
    "llm",
    "ai",
    "pricing",
    "calculator",
    "tokens",
    "cost",
    "ledger",
    "audit",
    "local",
    "provenance",
    "reconciliation",
    "cost-accounting",
    "llm-cost",
    "api-cost",
    "cost-tracking",
    "cached-tokens",
    "reasoning-tokens",
    "batch",
    "agents",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "opentelemetry",
    "usage"
  ],
  "sideEffects": false,
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "runcost": "./cli.js"
  },
  "files": [
    "index.js",
    "browser.js",
    "cli.js",
    "index.d.ts",
    "generated",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./index.d.ts",
      "default": "./browser.js"
    }
  }
}
